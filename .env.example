# Copy to .env (never commit .env). Values below are placeholders.
POSTGRES_USER=zyrquen
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zyrquen
JWT_SECRET_KEY=change-me-to-a-long-random-string
ZYRQUEN_MODEL_PATH=/data/models/zyrquen-native-v1
ZYRQUEN_DATASET_DIR=/data/datasets/current
ZYRQUEN_TOKENIZER_PATH=/data/tokenizers/tokenizer.json
ZYRQUEN_TRAINING_ROOT=/data/training
# Comma-separated authenticated user emails allowed to manage training jobs.
# Empty by default: training administration is disabled until explicitly configured.
ZYRQUEN_TRAINING_ADMIN_EMAILS=
