        {"id": "bm_left", "description": "Left branch", "depends_on": ["bm_root"], "success_criteria": "ok"},
        {"id": "bm_right", "description": "Right branch", "depends_on": ["bm_root"], "success_criteria": "ok"},
        {"id": "bm_join", "description": "Join branch", "depends_on": ["bm_left", "bm_right"], "success_criteria": "ok"}
