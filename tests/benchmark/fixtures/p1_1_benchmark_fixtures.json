  "forbidden_training_prefixes": ["TR_E", "VA_E", "TE_E", "UN_E", "OO_E", "node_tr_", "item_tr_", "step_tr_", "rec_tr_"],
  "positive_cases": {
    "knowledge_direct_lookup": {
