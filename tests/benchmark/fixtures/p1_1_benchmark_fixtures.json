    "planning_valid_dag": {
      "goal": "Prepare verified capability snapshot without modifying core weights",
      "steps": [
        {
          "id": "bm_step_load_fixtures",
          "description": "Load isolated P1-1 held-out benchmark fixtures",
          "depends_on": [],
          "success_criteria": "Fixtures schema validated"
        },
        {
          "id": "bm_step_run_checks",
          "description": "Run real core interface probes",
          "depends_on": ["bm_step_load_fixtures"],
          "success_criteria": "Deterministic counts collected"
        },
        {
          "id": "bm_step_emit_report",
          "description": "Emit reproducible P1-1 baseline report",
          "depends_on": ["bm_step_run_checks"],
          "success_criteria": "Baseline digest computed"
        }
      ]
    },
    "tool_read_only_auth": {
      "tool": {
        "name": "bm_doc_inspector",
        "description": "Read-only document metadata inspector",
        "effect": "read_only",
        "required_permission": "benchmark:read_doc",
        "input_schema": {
          "type": "object",
          "properties": {
            "doc_id": {"type": "string"}
          },
          "required": ["doc_id"],
          "additionalProperties": false
        }
      },
      "call": {
        "call_id": "bm-call-001",
        "tool_name": "bm_doc_inspector",
        "arguments": {"doc_id": "BM_DOC_101"}
      },
      "granted_permissions": ["benchmark:read_doc"]
    }
  },
  "negative_abstention_cases": {
