        "required_permission": "benchmark:publish",
        "input_schema": {
          "type": "object",
          "properties": {"target": {"type": "string"}},
          "required": ["target"],
          "additionalProperties": false
        }
      },
      "call": {
        "call_id": "bm-call-002",
        "tool_name": "bm_external_publish",
        "arguments": {"target": "public_feed"}
      }
    }
  },
  "math_logic_cases": {
